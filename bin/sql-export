#!/bin/sh
set -eu

SCRIPTS='
01_create_tables Version20261107185619
02_view_relatorio Version20261107233000
'

DATABASE_URL=$(printf '%s' "$DATABASE_URL" | sed -E 's#/[^/?]+\?#/app_sqlexport?#')
export DATABASE_URL

console() { bin/console --no-interaction --quiet "$@" </dev/null; }

console doctrine:database:drop --force --if-exists
console doctrine:database:create
trap 'console doctrine:database:drop --force --if-exists' EXIT

printf '%s\n' "$SCRIPTS" | while read -r nome versao; do
    [ -n "$nome" ] || continue
    arquivo="database/$nome.sql"
    bruto="var/$nome.sql"

    console doctrine:migrations:execute "DoctrineMigrations\\$versao" --up --write-sql="$bruto"

    {
        printf -- '-- Gerado por bin/sql-export a partir de migrations/%s.php. Não edite à mão.\n' "$versao"
        printf -- '-- Para regenerar: make sql-export. Para aplicar: ver "Scripts SQL" no README.\n\n'
        grep -v -e '^-- Doctrine Migration File Generated on' -e '^-- Version ' "$bruto" | sed '/./,$!d'
    } > "$arquivo"
    rm -f "$bruto"

    echo "Gerado: $arquivo"
done
