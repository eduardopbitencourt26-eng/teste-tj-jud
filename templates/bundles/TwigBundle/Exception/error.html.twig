{#
    Página de erro de produção (em dev aparece a página de depuração; para ver esta: /_error/404, /_error/503...).
    Mostra só uma mensagem amigável: detalhes do erro ficam no log, nunca na tela.
#}
{% extends 'base.html.twig' %}

{% set mensagens = {
    403: {titulo: 'Acesso negado', texto: 'Você não tem permissão para acessar esta página.'},
    404: {titulo: 'Página não encontrada', texto: 'O endereço não existe ou o registro foi excluído.'},
    405: {titulo: 'Ação não permitida', texto: 'Esta página não aceita esse tipo de requisição.'},
    503: {titulo: 'Sistema indisponível', texto: 'Não foi possível acessar o banco de dados. Tente de novo em alguns instantes.'},
} %}
{% set mensagem = mensagens[status_code] ?? {titulo: 'Erro inesperado', texto: 'Ocorreu um erro ao processar a sua solicitação. Tente de novo.'} %}

{% block title %}{{ mensagem.titulo }}{% endblock %}

{% block body %}
    <div class="py-4">
        <p class="text-body-secondary mb-1">Erro {{ status_code }}</p>
        <h1 class="mb-3">{{ mensagem.titulo }}</h1>
        <p>{{ mensagem.texto }}</p>
        <a href="{{ path('inicio') }}" class="btn btn-primary">Voltar ao início</a>
    </div>
{% endblock %}
